{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reflex Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "title",
    "created_at",
    "baseline_sha",
    "branch",
    "objective",
    "status",
    "task_packets",
    "human_gates"
  ],
  "properties": {
    "mission_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "IN_PROGRESS",
        "REVIEW",
        "BLOCKED",
        "DONE",
        "ABSTAINED"
      ]
    },
    "task_packets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
