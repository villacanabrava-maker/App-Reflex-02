{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reflex Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "source",
    "timestamp",
    "responsible_role"
  ],
  "properties": {
    "classification": {
      "enum": [
        "CONFIRMADO-CODIGO",
        "CONFIRMADO-TESTE",
        "CONFIRMADO-CI",
        "CONFIRMADO-RUNTIME",
        "CONFIRMADO-EXTERNO",
        "RELATADO",
        "INFERIDO",
        "PENDENTE",
        "BLOQUEADO"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_test": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "responsible_role": {
      "type": "string",
      "pattern": "^R[1-9]$"
    }
  }
}
