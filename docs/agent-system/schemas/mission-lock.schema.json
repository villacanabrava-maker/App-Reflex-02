{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissionLockSchemaV3",
  "description": "Controle de concorrência e ownership de missão entre runtimes no Reflex Agent OS V3",
  "type": "object",
  "required": [
    "mission_id",
    "owner_runtime",
    "owner_role",
    "branch",
    "scope",
    "started_at",
    "status"
  ],
  "properties": {
    "mission_id": { "type": "string" },
    "owner_runtime": {
      "type": "string",
      "enum": ["antigravity", "openai_codex", "human_manual", "unlocked"]
    },
    "owner_role": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "NONE"]
    },
    "branch": { "type": "string" },
    "scope": { "type": "string" },
    "started_at": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ACQUIRED", "IN_PROGRESS", "RELEASED", "HANDOFF_PENDING"]
    }
  },
  "additionalProperties": false
}
