# App Reflex 02 — Configurações de Ambiente (Modelo de Referência)

# Configurações do Supabase (URL e chaves públicas/privadas)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sua_secret_key
# Aliases legados compatíveis (opcionais):
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sua_secret_key

# OpenAI API (Opcional para recursos de IA)
OPENAI_API_KEY=sk-proj-...

# Feature flags cognitivas — produção inicia em fail-safe (off)
FEATURE_COGNITIVE_V31_RETRIEVAL=off
FEATURE_COGNITIVE_V31_DOSSIER=off
FEATURE_COGNITIVE_V31_AUDITOR=off
FEATURE_COGNITIVE_V31_ABSTENTION=off

# Motor legado do Cérebro que promovia inferências diretamente.
# Manter OFF; só habilitar temporariamente em diagnóstico controlado.
FEATURE_LEGACY_BRAIN_ANALYZER=off

