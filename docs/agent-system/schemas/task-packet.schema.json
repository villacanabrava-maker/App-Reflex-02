{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reflex Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "task_id",
    "created_at",
    "objective",
    "baseline_sha",
    "target_branch",
    "owner_role",
    "dependencies",
    "in_scope",
    "out_of_scope",
    "allowed_tools",
    "write_scope",
    "risk_level",
    "acceptance_criteria",
    "required_evidence",
    "expected_artifacts",
    "status",
    "blocked_by",
    "next_handoff"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "baseline_sha": {
      "type": "string",
      "minLength": 7
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_role": {
      "type": "string",
      "pattern": "^R[1-9]$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "REJECTED",
        "DONE",
        "ABSTAINED"
      ]
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_handoff": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
