# App Reflex 02 — Configurações de Ambiente (Modelo de Referência)

# Configurações do Supabase (URL e chaves públicas/privadas)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sua_secret_key
# Aliases legados compatíveis (opcionais):
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sua_secret_key

# OpenAI API (Opcional para recursos de IA)
OPENAI_API_KEY=sk-proj-...

